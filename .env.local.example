# ====================================
# 模型提供商切换
# ====================================
# volcengine = 国内火山引擎 ARK（默认）
# byteplus  = 海外 BytePlus ModelArk
# IMAGE_PROVIDER=byteplus

# ====================================
# 国内火山引擎 ARK（默认 provider）
# ====================================
# ARK_API_KEY=ark-your-key
# ARK_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
# ARK_IMAGE_MODEL=doubao-seedream-4-5-251128

# ====================================
# 海外 BytePlus ModelArk
# ====================================
# BYTEPLUS_API_KEY=ark-your-key
# BYTEPLUS_API_ENDPOINT=https://ark.ap-southeast.bytepluses.com/api/v3
# BYTEPLUS_IMAGE_MODEL=seedream-5-0-260128